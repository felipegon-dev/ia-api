NODE_ENV=development
JWT_SECRET=super_jwt_secret
TOKEN_ENCRYPTION_SECRET=12345678901234567890123456789012
TOKEN_ENCRYPTION_ENABLED=true
TOKEN_ALGORITHM=aes-256-gcm
TOKEN_EXPIRATION=1m
#DEV
CALLBACK_HOST=https://ungraved-intercoracoid-christoper.ngrok-free.dev
#PROD
#CALLBACK_HOST=https://api-clients-callback-checkout.informaticaautonomos.com
REDIS_HOST=ia-redis-checkout
REDIS_PORT=6379
REDIS_PASSWORD=test
DB_HOST=ia-mysql-checkout
DB_USERNAME=iaapi
DB_PASSWORD=iaapi
DB_DATABASE=iaapi
# Pending worker events TTL (24h). Expired/failed events go to default_stream:dead; reconcile that DLQ manually.
REDIS_MESSAGE_EXPIRATION_MS=86400000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50
# Generate with: htpasswd -nbB admin your-password
ADMIN_BASIC_AUTH_HTPASSWD='admin:$2y$05$ncJyKw7Y30hQmqBCWJC4.uR0DwPYZS0ywwY9xQBUU0OxIz/ifo6yy'
# Encrypts per-domain HMAC signing keys at rest (AES-256-GCM), min 32 chars. Required to generate/read keys;
# domains without keys (legacy, prices NOT protected) work without it. Never rotate it without re-encrypting keys.
# Generate with: openssl rand -base64 48
HMAC_ENCRYPTION_SECRET=change-me-with-openssl-rand-base64-48-characters
# Shared with ia-website to sign admin identity (x-ia-admin-* headers). Required, min 32 chars, SAME value in
# ia-website. If missing or different, every /api/v1/admin call is rejected (fail closed).
# Generate with: openssl rand -base64 48
IA_ADMIN_SHARED_SECRET=change-me-with-openssl-rand-base64-48-characters
